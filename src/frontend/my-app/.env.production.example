# ========================================================
# CASOC Production Frontend Environment Configuration
# Add these environment variables in Cloudflare Pages or Vercel
# ========================================================

# Your deployed Render or Railway NIDS ML API URL
VITE_NIDS_API_URL=https://casoc-nids-ml-api.onrender.com

# Your deployed Render or Railway Insider Threat URL
VITE_INSIDER_API_URL=https://casoc-insider-threat.onrender.com

# Optional: Gateway URL (if deployed)
VITE_GATEWAY_URL=https://casoc-gateway.onrender.com

# Secret Agent Key matching AGENT_API_KEY on the Insider Threat server
VITE_AGENT_API_KEY=dev-agent-key-change-in-production
